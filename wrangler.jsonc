{
  // Configuración del Worker "amc2" en Cloudflare (plan gratuito).
  "name": "amc2",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "CATALOGO", "id": "10f7c3da7a9940a597c1726332dcc6a6" }
  ],
  "observability": { "enabled": true }
}
